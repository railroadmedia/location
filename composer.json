{
  "name": "railroad/location",
  "type": "library",
  "description": "Location service",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.9",
    "guzzlehttp/guzzle": "^7.2",
    "league/iso3166": "^3.0.0",
    "sokil/php-isocodes": "^4.0",
    "sokil/php-isocodes-db-only": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0.1",
    "phpunit/php-code-coverage": "^11.0.1",
    "orchestra/testbench": "^9.2"
  },
  "autoload": {
    "psr-4": {
      "Railroad\\Location\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Railroad\\Location\\Tests\\": "tests/"
    }
  }
}